/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/regulator/samsung,s2mpg12-regulator.h>

#include "gs201.dtsi"

/ {
	model = "Google Pixel 7a (Lynx)";
	compatible = "google,gs201-lynx", "google,gs201";

	chosen {
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		stdout-path = "serial0:115200n8";

		/* Use display framebuffer as setup by bootloader */
		framebuffer0: framebuffer-0 {
			compatible = "simple-framebuffer";
			memory-region = <&cont_splash_mem>;
			width = <1080>;
			height = <2400>;
			stride = <(1080 * 4)>;
			format = "a8r8g8b8";
		};
	};

	reserved-memory {
		cont_splash_mem: splash@fac00000 {
			reg = <0x0 0xfac00000 (1080 * 2400 * 4)>;
			no-map;
		};
	};
};

/* Bring-up: peripherals not listed here keep the bootloader's clock state. */
&acpm_ipc {
	pmic-1 {
		compatible = "samsung,s2mpg12-pmic";
		interrupts-extended = <&gpa0 6 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&pmic_int>;
		wakeup-source;

		/*
		 * Only the rails with a consumer are described; all other
		 * rails stay as the bootloader left them.
		 */
		regulators {
			/* HSI0 IO rail; the controller hangs without it */
			s2mpg12_ldo7m: ldo7m {
				regulator-name = "vdd_hsi";
				regulator-min-microvolt = <450000>;
				regulator-max-microvolt = <950000>;
				regulator-ramp-delay = <6250>;
				regulator-always-on;
			};

			/* USB PHY 0.85V (PLL, USB2 DVDD, USBDP VDDA) */
			s2mpg12_ldo8m: ldo8m {
				regulator-name = "vdd085_usb";
				regulator-min-microvolt = <725000>;
				regulator-max-microvolt = <1300000>;
				regulator-always-on;
			};

			/* USB PHY 1.8V (USB2 and USBDP VDDH) */
			s2mpg12_ldo9m: ldo9m {
				regulator-name = "vdd18_usb";
				regulator-min-microvolt = <1600000>;
				regulator-max-microvolt = <1950000>;
				regulator-always-on;
			};

			/* USB PHY 3.0V (USB2 VDD33) */
			s2mpg12_ldo10m: ldo10m {
				regulator-name = "vdd33_usb";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3350000>;
				regulator-always-on;
			};

			/* Touchscreen DVDD */
			s2mpg12_ldo25m: ldo25m {
				regulator-name = "ldo25m_ts_dvdd";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};

			/* Touchscreen AVDD */
			s2mpg12_ldo26m: ldo26m {
				regulator-name = "ldo26m_ts_avdd";
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
			};
		};
	};
};

&cmu_disp {
	status = "okay";
};

&cmu_dpu {
	status = "okay";
};

&cmu_hsi0 {
	status = "okay";
};

&cmu_hsi2 {
	status = "okay";
};

&cmu_misc {
	status = "okay";
};

&cmu_peric0 {
	status = "okay";
};

&cmu_peric1 {
	status = "okay";
};

&cmu_top {
	status = "okay";
};

&dpu {
	status = "okay";
};

&dsim0 {
	status = "okay";

	panel@0 {
		compatible = "samsung,s6e3fc5";
		reg = <0>;
	};
};

&usi_spi0 {
	status = "okay";
};

&spi_0 {
	cs-gpios = <&gpp20 3 GPIO_ACTIVE_LOW>;
	status = "okay";

	touchscreen@0 {
		compatible = "goodix,gt9916";
		reg = <0>;
		spi-max-frequency = <10000000>;
		interrupt-parent = <&gpa7>;
		interrupts = <0 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&gpp23 2 GPIO_ACTIVE_LOW>;
		avdd-supply = <&s2mpg12_ldo26m>;
		vddio-supply = <&s2mpg12_ldo25m>;
		pinctrl-0 = <&ts_irq &ts_reset>;
		pinctrl-names = "default";
		touchscreen-size-x = <1080>;
		touchscreen-size-y = <2400>;
	};
};

&gpu {
	status = "okay";
};

&serial_0 {
	status = "okay";
};

&usbdrd31 {
	vdd10-supply = <&s2mpg12_ldo7m>;
	vdd33-supply = <&s2mpg12_ldo10m>;

	status = "okay";
};

&usbdrd31_dwc3 {
	dr_mode = "peripheral";
	maximum-speed = "high-speed";

	status = "okay";
};

&usbdrd31_phy {
	pll-supply = <&s2mpg12_ldo8m>;
	dvdd-usb20-supply = <&s2mpg12_ldo8m>;
	vddh-usb20-supply = <&s2mpg12_ldo9m>;
	vdd33-usb20-supply = <&s2mpg12_ldo10m>;
	vdda-usbdp-supply = <&s2mpg12_ldo8m>;
	vddh-usbdp-supply = <&s2mpg12_ldo9m>;

	status = "okay";
};

&watchdog_cl0 {
	status = "okay";
};

&watchdog_cl1 {
	status = "okay";
};

&ufs_0 {
	status = "okay";
};

&ufs_0_phy {
	status = "okay";
};

/* TEMP-DEBUG T1: glue enabled, child without ref clock / phys */
&usbdrd31_dwc3 {
	/delete-property/ clocks;
	/delete-property/ clock-names;
	/delete-property/ phys;
	/delete-property/ phy-names;
};
